diff --color -ru -x b pristine/pyhmmer-0.12.3/vendor/easel/esl_stopwatch.c pyhmmer-0.12.3/vendor/easel/esl_stopwatch.c
--- pristine/pyhmmer-0.12.3/vendor/easel/esl_stopwatch.c	2022-11-09 04:37:21
+++ pyhmmer-0.12.3/vendor/easel/esl_stopwatch.c	2026-10-13 10:54:15
@@ -8,6 +8,25 @@
  *     http://creativecommons.org/licenses/by/3.0/deed.en_US
  */
 #include <esl_config.h>
+#if defined(__EMSCRIPTEN__)
+/* Pyodide's C library has no times(). Stand in with clock(): CPU time only, used for timing
+ * output, never for results. */
+#include <sys/times.h>
+#include <time.h>
+static clock_t esl_emscripten_times(struct tms *buf) {
+  clock_t c = clock();
+  if (buf) { buf->tms_utime = c; buf->tms_stime = 0; buf->tms_cutime = 0; buf->tms_cstime = 0; }
+  return c;
+}
+#define times esl_emscripten_times
+/* time(): wall-clock seconds are not needed for results; this avoids a 64-bit host import. */
+static time_t esl_emscripten_time(time_t *t) {
+  time_t v = (time_t)(clock() / CLOCKS_PER_SEC);
+  if (t) *t = v;
+  return v;
+}
+#define time esl_emscripten_time
+#endif
 
 #include "easel.h"
 #include "esl_stopwatch.h"
