#!/usr/bin/env python3
"""Command-line stand-in for tblastn. Logic lives in ../localizer.py (shared with the browser bridge)."""
import os, shlex, subprocess, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import localizer

MMSEQS = shlex.split(os.environ.get("MMSEQS_CMD", "mmseqs"))
THREADS = os.environ.get("MMSEQS_THREADS", "1")


def _run(argv):
    subprocess.run(argv, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


sys.stdout.write(localizer.tblastn(sys.argv[1:], MMSEQS, _run, threads=THREADS,
                                   max_seqs=os.environ.get("MMSEQS_MAX", "5000"),
                                   s=os.environ.get("MMSEQS_S", "7.5"), e=os.environ.get("MMSEQS_E", "10")))
