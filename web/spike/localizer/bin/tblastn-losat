#!/usr/bin/env python3
"""tblastn stand-in backed by LOSAT (pure-Rust BLAST reimplementation): protein query vs genome FASTA.

LOSAT takes the genome as -subject, so no database is built. Its 12-column output is converted to the
pipeline's 11-column outfmt (search.py _TBLASTN_OUTFMT): query length comes from the query FASTA, coverage
from the query range, and sframe from the subject order. LOSAT_BIN selects the binary (native or WASI via
LOSAT_WASI_RUNNER, e.g. "node run-losat-wasi.mjs /path/LOSAT.wasm").
"""
import os, shlex, subprocess, sys
args = sys.argv[1:]
query = args[args.index("-query") + 1]
subject = args[args.index("-subject") + 1] if "-subject" in args else args[args.index("-db") + 1] + ".fa"
LOSAT = shlex.split(os.environ.get("LOSAT_BIN", "LOSAT"))
qlen = {}
name = None
with open(query) as fh:
    for line in fh:
        line = line.strip()
        if line.startswith(">"):
            name = line[1:].split()[0]
            qlen[name] = 0
        elif line:
            qlen[name] += len(line)
cmd = LOSAT + ["tblastn", "-query", query, "-subject", subject, "-task", "tblastn", "-outfmt", "6",
               "-seg", "no", "-num_threads", os.environ.get("LOSAT_THREADS", "1")]
res = subprocess.run(cmd, capture_output=True, text=True, check=True)
out = sys.stdout
for line in res.stdout.splitlines():
    f = line.split("\t")
    q, s, pid, length, qs, qe, ss, se, ev, bits = f[0], f[1], f[2], f[3], int(f[6]), int(f[7]), int(f[8]), int(f[9]), f[10], f[11]
    ql = qlen[q]
    qcov = 100.0 * (max(qs, qe) - min(qs, qe) + 1) / ql
    sframe = 1 if ss < se else -1
    out.write("\t".join([q, s, pid, length, str(ql), f"{qcov:.3f}", ev, bits, str(ss), str(se), str(sframe)]) + "\n")
